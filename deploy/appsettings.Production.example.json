{
  "//": "Only if the Control Panel's environment variables can't be used: copy to the server as appsettings.Production.json (next to Codlek.Api.dll) and fill it in there. Never commit the filled file.",
  "ConnectionStrings": {
    "Default": "Server=<server>;Database=<database>;User Id=<user>;Password=<password>;TrustServerCertificate=True"
  },
  "Codlek": {
    "SiteUrl": "https://codlek.com",
    "PublicUrl": "https://<api-host>",
    "CorsOrigins": "https://codlek.com,https://www.codlek.com",
    "RevalidateUrl": "https://codlek.com/api/revalidate",
    "RevalidateSecret": "<same value as REVALIDATE_SECRET on Vercel>",
    "MigrateOnStartup": true
  },
  "Mail": {
    "Driver": "resend",
    "FromAddress": "no-reply@codlek.com",
    "FromName": "Codlek",
    "ResendApiKey": "<re_...>"
  }
}
