# The API as the Next.js server reaches it (server-side reads).
API_URL=http://localhost:5080

# The API as visitors' browsers reach it (the forms post there). Must be https in production.
NEXT_PUBLIC_API_URL=http://localhost:5080

# Where this site is published (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with the API (Codlek:RevalidateSecret): lets it drop the cache after admin saves.
REVALIDATE_SECRET=change-me

# Sentry project codlek-web (Sentry: the project -> Settings -> Client Keys). Empty = Sentry off.
NEXT_PUBLIC_SENTRY_DSN=

# Optional, build only: uploads source maps for readable stack traces (Sentry: Settings -> Auth Tokens).
SENTRY_AUTH_TOKEN=
