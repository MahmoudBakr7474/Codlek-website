<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The SDK's route handler analyzer crashes (NullReferenceException) on the generic admin endpoints. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
    <!-- The packages' translated error messages (cs, de, ...): the API's own messages are in its Content. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.12.1" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exported from the Laravel site: content defaults, lists and UI texts. -->
    <Content Update="Content\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Uploaded pictures, CVs and sign-in keys live on the server: a publish must not carry (or overwrite) them. -->
    <Content Update="wwwroot\uploads\**" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json;appsettings.Production.json" CopyToPublishDirectory="Never" />
    <Content Remove="storage\**" />
    <None Remove="storage\**" />
  </ItemGroup>

  <!--
    The server is Windows IIS: a publish leaves out the Linux and macOS native libraries, and
    the native debug symbols (SkiaSharp's are ~100 MB per platform).
  -->
  <Target Name="TrimNativeAssetsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/')) And ('%(ResolvedFileToPublish.Extension)' == '.pdb' Or $([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[\\/](linux|osx|unix)')))" />
    </ItemGroup>
  </Target>

</Project>
