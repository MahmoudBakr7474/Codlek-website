@* The visitor's own text: a table cell (Outlook ignores padding on a div), line
   breaks as <br> since not every client keeps white-space. *@
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E3EAF5;border-radius:14px;border-collapse:separate;">
    <tr><td dir="auto" style="padding:16px 20px;text-align:start;color:#0B1B3F;word-break:break-word;">
        @for (var i = 0; i < Lines.Length; i++)
        {
            @if (i > 0)
            {
                <br>
            }
            @Lines[i]
        }
    </td></tr>
</table>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    private string[] Lines => Text.ReplaceLineEndings("\n").Split('\n');
}
