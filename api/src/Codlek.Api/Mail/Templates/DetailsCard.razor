@* The light card of "label over value" rows in the company mails: long e-mail
   addresses and links still fit on a phone. *@
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#F5F7FA" style="background:#F5F7FA;border:1px solid #E2E7EE;border-radius:14px;border-collapse:separate;">
    <tr>
        <td dir="rtl" style="padding:4px 20px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                @for (var i = 0; i < Rows.Count; i++)
                {
                    var row = Rows[i];
                    <tr><td style="padding:12px 0;text-align:right;@(i > 0 ? "border-top:1px solid #E2E7EE;" : "")">
                        <p style="margin:0;font-size:13px;line-height:1.6;color:#5B6676;">@row.Label</p>
                        <p style="margin:0;font-size:15px;line-height:1.6;font-weight:700;color:#0B1B3F;word-break:break-word;">
                            @if (row.Href is not null)
                            {
                                <a href="@row.Href" dir="ltr" style="color:#0B63CE;text-decoration:none;">@row.Value</a>
                            }
                            else
                            {
                                @row.Value
                            }
                        </p>
                    </td></tr>
                }
            </table>
        </td>
    </tr>
</table>

@code {
    public sealed record Row(string Label, string Value, string? Href = null);

    [Parameter, EditorRequired] public IReadOnlyList<Row> Rows { get; set; } = [];
}
